{
    // Run ESLint fixes automatically on save
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "always"
  },

  // Tailwind at-rules (@apply, @tailwind, @screen, etc.) aren't real CSS/SCSS,
  // so the built-in language server flags them as unknown at-rules
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",

  // Disable VSCode's built-in formatter or Prettier from interfering
  "editor.formatOnSave": false,

  "cSpell.words": [
    "chartjs",
    "classnames",
    "headlessui",
    "heroicons",
    "nitropack",
    "Nuxt",
    "ofetch",
    "unref"
  ],
  // Use ESLint as the default formatter for Vue, TypeScript, and JavaScript files
  "[vue]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },

  // Optional: ensure ESLint handles JSON/YAML if desired
  "[json]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[yaml]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  }
}
