# Update values and rename to .env
COMPOSE_HTTP_TIMEOUT=10
COMPOSE_PROJECT_NAME=<project-name>
COMPOSE_PROFILES=<live for real deployment, otherwise empty>
APP_ENV=<prod|staging|test|dev>
NETWORK_SUBNET=<docker-local-network>
NETWORK_GATEWAY_IP=<ip address in subnet ending in .1>
NETWORK_DB_IP=<ip address in subnet ending in .2>
NETWORK_NODE_IP=<ip address in subnet ending in .3>
NETWORK_VIDEO_WORKER_IP=<ip address in subnet ending in .4>
NETWORK_ADMINER_IP=<ip address in subnet ending in .5>
# For access to the docker MariaDB database
MARIADB_ROOT_PASSWORD=<root-password>
MARIADB_HOST=<ip or hostname>
MARIADB_DATABASE=swimming
MARIADB_USER=swimming
MARIADB_PASSWORD=<user-password>
# Don't count logins from these IPs
IGNORE_IPS=<ip1,ip2...>
# For access to adminer DB management
ADMINER_ALLOWED_IPS=<ip1,ip2...>
# AWS / video storage
# AWS region where the S3 bucket is hosted
AWS_REGION=<e.g. eu-west-2>
# IAM access key used by the app/worker to read, upload and delete video files in S3
AWS_ACCESS_KEY_ID=<aws-access-key-id>
# IAM secret key paired with AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
# S3 bucket name used to store original and compressed video files
AWS_S3_BUCKET=<s3-bucket-name>
# Public CloudFront base URL used to serve video files
# Example: https://dxxxxxxxxxxxx.cloudfront.net
# Do not include a trailing slash
AWS_CLOUDFRONT_URL=<cloudfront-base-url>
