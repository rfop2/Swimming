# Update values and rename to .env
COMPOSE_HTTP_TIMEOUT=10
COMPOSE_PROJECT_NAME=<project-name>
APP_ENV=<prod|staging|test|dev>
NETWORK_SUBNET=<docker-local-network>
NETWORK_GATEWAY_IP=<ip address in subnet ending in .1>
NETWORK_NODE_IP=<ip address in subnet ending in .2>
NETWORK_DB_IP=<ip address in subnet ending in .2>
NETWORK_ADMINER_IP=<ip address in subnet ending in .4>
# For access to the docker MariaDB database
MARIADB_ROOT_PASSWORD=<root-password>
MARIADB_DATABASE=swimming
MARIADB_USER=swimming
MARIADB_PASSWORD=<user-password>
# Don't count logins from these IPs
IGNORE_IPS=<ip1,ip2...>
# For access to adminer DB management
ADMINER_ALLOWED_IPS=<ip1,ip2...>
