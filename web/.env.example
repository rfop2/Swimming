# For access to the docker MariaDB database in dev mode
MARIADB_ROOT_PASSWORD=<root-password>
MARIADB_HOST=<ip or hostname>
MARIADB_DATABASE=swimming
MARIADB_USER=swimming
MARIADB_PASSWORD=<user-password>
# Don't count logins from these IPs
IGNORE_IPS=<ip1,ip2...>
# Google Analytics 4 measurement ID (leave unset to disable analytics)
NUXT_PUBLIC_GTAG_ID=<G-XXXXXXXXXX>
