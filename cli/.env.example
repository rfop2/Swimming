# Update values and rename to .env
# Paid or trial account API key from scraperapi.com>
SCRAPER_API_KEY=<api-key>
# How long to keep fetched pages for before re-fetching
PAGE_CACHE_TIME=<cache-hours>
# How often to check for task updates
TASK_CHECK_INTERVAL=<seconds>
# For access to the docker MariaDB database
MARIADB_HOST=<ip or hostname>
MARIADB_DATABASE=swimming
MARIADB_USER=swimming
MARIADB_PASSWORD=<user-password>
# Update type queued for swimmers found in meet results: individual, results or
# rankings (default). Set to "results" to temporarily skip rankings/performance.
MEET_RESULTS_UPDATE_TYPE=<individual|results|rankings>
